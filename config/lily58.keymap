#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/*
 * Scylla physical layout, for ZMK Studio. The Scylla uses the Lily58 matrix and
 * key order, so the keymap below is unchanged: this only tells Studio where each
 * key sits. Same positions as config/info.json (the Keymap Editor's copy), in
 * hundredths of a key.
 */
/ {
    chosen {
        zmk,physical-layout = &scylla_layout;
    };

    scylla_layout: scylla_layout {
        compatible = "zmk,physical-layout";
        display-name = "Scylla";
        transform = <&default_transform>;

        keys  //                     w   h     x     y      rot    rx    ry
            = <&key_physical_attrs 100 100     0    91        0     0     0>
            , <&key_physical_attrs 100 100   100    91        0     0     0>
            , <&key_physical_attrs 100 100   200    32        0     0     0>
            , <&key_physical_attrs 100 100   300     0        0     0     0>
            , <&key_physical_attrs 100 100   400    21        0     0     0>
            , <&key_physical_attrs 100 100   500    21        0     0     0>
            , <&key_physical_attrs 100 100  1100    21        0     0     0>
            , <&key_physical_attrs 100 100  1200    21        0     0     0>
            , <&key_physical_attrs 100 100  1300     0        0     0     0>
            , <&key_physical_attrs 100 100  1400    32        0     0     0>
            , <&key_physical_attrs 100 100  1500    91        0     0     0>
            , <&key_physical_attrs 100 100  1600    91        0     0     0>
            , <&key_physical_attrs 100 100     0   191        0     0     0>
            , <&key_physical_attrs 100 100   100   191        0     0     0>
            , <&key_physical_attrs 100 100   200   132        0     0     0>
            , <&key_physical_attrs 100 100   300   100        0     0     0>
            , <&key_physical_attrs 100 100   400   121        0     0     0>
            , <&key_physical_attrs 100 100   500   121        0     0     0>
            , <&key_physical_attrs 100 100  1100   121        0     0     0>
            , <&key_physical_attrs 100 100  1200   121        0     0     0>
            , <&key_physical_attrs 100 100  1300   100        0     0     0>
            , <&key_physical_attrs 100 100  1400   132        0     0     0>
            , <&key_physical_attrs 100 100  1500   191        0     0     0>
            , <&key_physical_attrs 100 100  1600   191        0     0     0>
            , <&key_physical_attrs 100 100     0   291        0     0     0>
            , <&key_physical_attrs 100 100   100   291        0     0     0>
            , <&key_physical_attrs 100 100   200   232        0     0     0>
            , <&key_physical_attrs 100 100   300   200        0     0     0>
            , <&key_physical_attrs 100 100   400   221        0     0     0>
            , <&key_physical_attrs 100 100   500   221        0     0     0>
            , <&key_physical_attrs 100 100  1100   221        0     0     0>
            , <&key_physical_attrs 100 100  1200   221        0     0     0>
            , <&key_physical_attrs 100 100  1300   200        0     0     0>
            , <&key_physical_attrs 100 100  1400   232        0     0     0>
            , <&key_physical_attrs 100 100  1500   291        0     0     0>
            , <&key_physical_attrs 100 100  1600   291        0     0     0>
            , <&key_physical_attrs 100 100     0   391        0     0     0>
            , <&key_physical_attrs 100 100   100   391        0     0     0>
            , <&key_physical_attrs 100 100   200   332        0     0     0>
            , <&key_physical_attrs 100 100   300   300        0     0     0>
            , <&key_physical_attrs 100 100   400   321        0     0     0>
            , <&key_physical_attrs 100 100   500   321        0     0     0>
            , <&key_physical_attrs 100 100   716   468     2000   766   518>
            , <&key_physical_attrs 100 100   871   468  (-2000)   921   518>
            , <&key_physical_attrs 100 100  1100   321        0     0     0>
            , <&key_physical_attrs 100 100  1200   321        0     0     0>
            , <&key_physical_attrs 100 100  1300   300        0     0     0>
            , <&key_physical_attrs 100 100  1400   332        0     0     0>
            , <&key_physical_attrs 100 100  1500   391        0     0     0>
            , <&key_physical_attrs 100 100  1600   391        0     0     0>
            , <&key_physical_attrs 100 100   589   539     1000   639   589>
            , <&key_physical_attrs 100 100   686   564     2000   736   614>
            , <&key_physical_attrs 100 100   500   432        0     0     0>
            , <&key_physical_attrs 100 100   602   441     1000   652   491>
            , <&key_physical_attrs 100 100   986   441  (-1000)  1036   491>
            , <&key_physical_attrs 100 100  1100   432        0     0     0>
            , <&key_physical_attrs 100 100   902   564  (-2000)   952   614>
            , <&key_physical_attrs 100 100   998   539  (-1000)  1048   589>
            ;
    };
};

/* Drop the stock Lily58 drawing so Studio only offers the Scylla one. */
/delete-node/ &kata0510_lily58_layout;

/ {
    // Combo keys are a way to combine multiple keypresses to output a different key.
    combos {
        compatible = "zmk,combos";

        combo_clear_bluetooth {
            timeout-ms = <50>; // Press all the below keys within 50ms to activate mapping
            key-positions = <52 42 0>; // Press 52=LOWER, 42=[, 0=tilde
            bindings = <&bt BT_CLR>; // activate clear bluetooth bindings for current channel
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |   `      |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
            // |  TAB     |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   =   |
            // |hCTRL tESC|  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT    |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                        | ALT  | GUI  | LOWER|  SPACE |  | BSPC  | ENTER| RAISE | CTRL  |

            bindings = <
      &kp GRAVE  &kp N1  &kp N2    &kp N3     &kp N4    &kp N5                        &kp N6  &kp N7     &kp N8    &kp N9    &kp N0    &kp MINUS
      &kp TAB    &kp Q   &kp W     &kp E      &kp R     &kp T                         &kp Y   &kp U      &kp I     &kp O     &kp P     &kp EQUAL
&mt LCTRL ESC    &kp A   &kp S     &kp D      &kp F     &kp G                         &kp H   &kp J      &kp K     &kp L     &kp SEMI  &kp SQT
    &kp LSHFT    &kp Z   &kp X     &kp C      &kp V     &kp B  &kp LBKT     &kp RBKT  &kp N   &kp M      &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                                   &kp LALT   &kp LMETA &mo 2  &kp SPACE    &kp BSPC  &kp RET &mo 1      &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  F12    |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |   F7  |   F8  |  F9  |  F10  |  F11  |
            // |   `     |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |   -   |
            // |CTRL/ESC |     |     |      |      |      |                   |  <-  |   ^   |   v   |  ->  |       |       |
            // | SHIFT   |     |     |      |      |      |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                       |      |      |      |        |  |       |      |       |       |

            bindings = <
      &kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                   &kp F6       &kp F7     &kp F8     &kp F9    &kp F10   &kp F11
    &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                   &kp N6       &kp N7     &kp N8     &kp N9    &kp N0    &kp MINUS
&mt LCTRL ESC  &trans  &trans  &trans  &trans  &trans                   &kp LEFT     &kp DOWN   &kp UP     &kp RIGHT &trans    &trans
   &kp LSHIFT  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &kp KP_PLUS  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp RIGHT_SHIFT
                               &trans  &trans  &trans  &trans  &trans   &trans       &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |          | BT1     | BT2    |  BT3 |  BT4  |  BT5 |                    |      |       |       |      |       |STUDIO |
            // |          |         |        |      |       |      |                    |      |       |       |  [   |   ]   |   \   |
            // |   ~      |  !      |  @     |  #   |  $    |  %   |                    |  ^   |  &    |  *    |  (   |   )   |   _   |
            // | SHIFT    |  EP_ON  | EP_OFF |      |  (    |  {   |       |  |   DEL   |  }   |  )    |  +    |  {   |   }   | SHIFT |
            //                               |      |       |      |       |  |         |      |       |       |
            bindings = <
    &trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans     &trans      &trans          &trans     &trans    &studio_unlock
    &trans       &trans        &trans        &trans        &trans        &trans                        &trans     &trans      &trans          &kp LBKT   &kp RBKT  &kp BSLH
    &kp TILDE    &kp EXCL      &kp AT        &kp HASH      &kp DOLLAR    &kp PRCNT                     &kp CARET  &kp AMPS    &kp KP_MULTIPLY &kp LPAR   &kp RPAR  &kp UNDER
    &kp LSHIFT   &trans        &trans        &kp LPAR      &kp LBRC      &trans    &trans    &kp DEL   &kp RBRC   &kp RPAR    &kp KP_PLUS     &kp LBRC   &kp RBRC  &kp RSHFT
                                             &trans        &trans        &trans    &trans    &trans    &trans     &trans      &trans    
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
